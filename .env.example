# Salin menjadi .env lalu isi nilai sebenarnya. JANGAN commit .env
FLASK_ENV=development
SECRET_KEY=<isi-dengan-string-acak-panjang>
MONGO_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=retailbrain
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=120
ADMIN_SESSION_LIFETIME_MINUTES=30
RATELIMIT_STORAGE_URI=memory://
DELIVERY_FEE=10000
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_MB=2
ALLOW_ADMIN_BOOTSTRAP=true
DEMO_PASSWORD=DemoPass123!

